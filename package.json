{
  "name": "pubky-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:crdt": "vitest run src/lib/crdt.test.ts src/lib/crdt.convergence.test.ts src/lib/local-notebook.test.ts src/lib/notebook-sync.test.ts src/lib/notebook-sync.integration.test.ts src/lib/notes.test.ts src/App.sync.test.tsx",
    "test:crdt:mutations": "node scripts/check-crdt-mutations.mjs",
    "test:interop": "npm --prefix ../pubky-notes-cli run build && node scripts/crdt-interop.mjs",
    "test:homeserver": "npm --prefix ../pubky-notes-cli run build && node scripts/crdt-homeserver.mjs --local-testnet",
    "test:collaboration": "vitest run src/lib/shared-note.test.ts src/lib/collaboration",
    "test:collaboration:infrastructure": "node --test scripts/test-collaboration-infrastructure.mjs",
    "test:collaboration:browser": "playwright test",
    "signaling": "node scripts/collaboration-signaling.mjs",
    "test:editing:browser": "npm run build && playwright test --config=playwright.editing.config.ts"
  },
  "dependencies": {
    "@synonymdev/pubky": "0.17.1",
    "fast-diff": "1.3.0",
    "fflate": "0.8.3",
    "lucide-react": "^1.67.0",
    "mermaid": "12.2.0",
    "micromark-util-decode-string": "2.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "fake-indexeddb": "6.2.7",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
