# Deployed app: mainnet, sign in with an existing Pubky Ring identity.
VITE_PUBKY_TESTNET=false
# To use a separately running local Pubky testnet, set true.
# VITE_PUBKY_TESTNET_HOST=localhost
# Optional dedicated Pubky auth relay:
# VITE_PUBKY_HTTP_RELAY=https://your-relay.example/inbox/
# Optional collaboration rendezvous; defaults to Pubky's public HTTP relay.
# VITE_COLLAB_SIGNAL_URL=https://httprelay.pubky.app/inbox/
# An owned signaling WebSocket can be used instead (also allow it in production CSP).
# VITE_COLLAB_SIGNAL_URL=wss://your-signaling.example/
# Optional relay-only privacy mode; requires working TURN configuration.
# VITE_COLLAB_RELAY_ONLY=true
