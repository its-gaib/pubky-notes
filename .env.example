# Deployed app: mainnet, sign in with an existing Pubky Ring identity.
VITE_PUBKY_TESTNET=false
# To use a separately running local Pubky testnet, set true.
# VITE_PUBKY_TESTNET_HOST=localhost
# Optional dedicated Pubky auth relay:
# VITE_PUBKY_HTTP_RELAY=https://your-relay.example/inbox/
# Optional collaboration rendezvous; defaults to Pubky's public HTTP relay.
# VITE_COLLAB_SIGNAL_URL=https://httprelay.pubky.app/inbox/
# An owned signaling WebSocket can be used instead (also allow it in production CSP).
# VITE_COLLAB_SIGNAL_URL=wss://your-signaling.example/
# Optional relay-only privacy mode; requires working TURN configuration.
# VITE_COLLAB_RELAY_ONLY=true

# Optional TURN fallback. These settings are server-only; never prefix them VITE_.
# The default remains STUN-only until a provider and shared rate limits are configured.
# Managed Cloudflare Realtime TURN (requires your own TURN key/token):
# COLLABORATION_TURN_PROVIDER=cloudflare
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Shared admission settings required for either TURN provider:
# COLLABORATION_ALLOWED_ORIGINS=https://pubky-notes.vercel.app
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Alternative: an existing coturn server. Do not mix these with Cloudflare settings.
# COLLABORATION_TURN_PROVIDER=coturn
# COLLABORATION_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# COLLABORATION_TURN_SECRET=
